# Web 管理密码 (默认 admin)
WEB_PASSWORD=''

# ---- 临时邮箱 (tempmail.ing) ----
# 创建邮箱 / 收信 / 提取验证码全部走 tempmail.ing 免费 API（无需密钥）。
# 留空则使用代码内默认值（见 src/mail_client.py 的 MailSettings）。
TEMPMAIL_API_BASE=
TEMPMAIL_SITE_ORIGIN=
TEMPMAIL_DURATION=10

# 验证码正则。留空 = 使用内置规则（ProxyScrape 的邮件是 8–16 位十六进制）：
#   1) 先匹配 "verification code: <8~16 位十六进制>"
#   2) 取不到再回退到正文中孤立的 8~16 位十六进制串
# 换站点时可以自己写，例如 6 位数字：
#   MAIL_CODE_REGEX=(?<!\d)(\d{6})(?!\d)
MAIL_CODE_REGEX=

# 发件人/主题关键字，逗号分隔；留空表示不筛选发件人（默认，推荐）
MAIL_SENDER_KEYWORDS=

# 收信轮询：间隔(秒) / 总超时(秒)
MAIL_POLL_INTERVAL=4
MAIL_POLL_TIMEOUT=150

# 单次 HTTP 请求超时(秒)
MAIL_REQUEST_TIMEOUT=15

# --- 创建邮箱速率控制（一般不用改）---
# MAIL_GENERATE_INTERVAL=15
# MAIL_GENERATE_RETRIES=3
# MAIL_GENERATE_BACKOFF=10
# MAIL_RATE_LIMIT_WAIT=5
# MAIL_BLACKLIST_RETRIES=5
# MAIL_DOMAIN_BLACKLIST=animatimg.com, tempmail.ing

# 注册密码配置
# 填写固定密码，留空或填写 random 则每次随机生成
REGISTER_PASSWORD=

# 注册间隔，单位秒
REGISTER_INTERVAL=5

# 可选：非交互指定注册数量
REGISTER_COUNT=5

# Turnstile Solver URL，留空则默认 http://127.0.0.1:5072
# Docker 内访问宿主机 Solver 时用 http://host.docker.internal:5072
TURNSTILE_SOLVER_URL=


# 注册机用的代理
PROXY=

# Resin remote subscription — full batch success uploads keys/proxies.txt
RESIN_SUBSCRIPTION_URL=https://resin.example.com/api/v1/subscriptions/***
RESIN_API_TOKEN=
RESIN_NAME=ProxyScrape
RESIN_UPDATE_INTERVAL=12h
RESIN_EPHEMERAL_NODE_EVICT_DELAY=72h0m0s
RESIN_ENABLED=true
RESIN_EPHEMERAL=false
RESIN_INCREMENTAL_ALIVE_NODES=false

# Updated via Web 配置页
MAX_CAPTCHA_FAIL_ROUNDS=3
PROXY_DOWNLOAD_PROTOCOL=http
# Docker 中需监听 0.0.0.0 才能从宿主机访问
WEB_HOST=127.0.0.1
WEB_PORT=5080
